---
import type { Language } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { t } = await useTranslations(lang);

interface Skill {
  name: string;
}

interface SkillCategory {
  key: string;
  titleKey: string;
  iconBg: string;
  iconText: string;
  iconLabel: string;
  skills: Skill[];
}

const skillCategories: SkillCategory[] = [
  {
    key: "languages",
    titleKey: "skills.languages",
    iconBg: "from-amber-500/20 to-yellow-600/10",
    iconText: "text-amber-500 dark:text-amber-400",
    iconLabel: "{ }",
    skills: [
      { name: "TypeScript" },
      { name: "JavaScript (ES6+)" },
      { name: "Python" },
      { name: "SQL" },
    ],
  },
  {
    key: "backend",
    titleKey: "skills.backend",
    iconBg: "from-green-500/20 to-emerald-600/10",
    iconText: "text-green-600 dark:text-green-400",
    iconLabel: "⚙",
    skills: [
      { name: "Node.js" },
      { name: "Express" },
      { name: "FastAPI" },
      { name: "Django" },
      { name: "REST APIs" },
      { name: "WebSockets" },
    ],
  },
  {
    key: "frontend",
    titleKey: "skills.frontend",
    iconBg: "from-violet-500/20 to-purple-600/10",
    iconText: "text-violet-600 dark:text-violet-400",
    iconLabel: "◈",
    skills: [
      { name: "React" },
      { name: "Next.js" },
      { name: "React Native" },
      { name: "Expo" },
      { name: "Zustand" },
      { name: "Tailwind CSS" },
      { name: "HTML5 / CSS3" },
    ],
  },
  {
    key: "databases",
    titleKey: "skills.databases",
    iconBg: "from-blue-500/20 to-indigo-600/10",
    iconText: "text-blue-600 dark:text-blue-400",
    iconLabel: "▦",
    skills: [
      { name: "PostgreSQL" },
      { name: "MySQL" },
      { name: "Redis" },
      { name: "Prisma" },
      { name: "Sequelize" },
    ],
  },
  {
    key: "devops",
    titleKey: "skills.devops",
    iconBg: "from-orange-500/20 to-red-600/10",
    iconText: "text-orange-600 dark:text-orange-400",
    iconLabel: "⬡",
    skills: [
      { name: "Docker" },
      { name: "Linux" },
      { name: "VPS" },
      { name: "Railway" },
      { name: "Vercel" },
      { name: "Git & CI/CD" },
    ],
  },
  {
    key: "architecture",
    titleKey: "skills.architecture",
    iconBg: "from-teal-500/20 to-emerald-600/10",
    iconText: "text-teal-600 dark:text-teal-400",
    iconLabel: "⌘",
    skills: [
      { name: "Software Architecture" },
      { name: "Clean Architecture" },
      { name: "Feature-based Architecture" },
      { name: "Design Patterns" },
      { name: "AI Integration" },
      { name: "Performance Optimization" },
    ],
  },
];
---

<section id="skills" class="py-32 sm:py-40 bg-slate-50 dark:bg-slate-950 relative overflow-hidden">

  <!-- Ambient blob -->
  <div
    class="absolute top-1/2 left-1/2 w-[900px] h-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(83,181,152,0.04) 0%, transparent 65%);"
    data-parallax="-0.04"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section heading -->
    <div class="text-center mb-20 reveal">
      <p class="eyebrow mb-3" data-i18n="skills.subtitle">{t("skills.subtitle")}</p>
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white section-title-center">
        <span data-i18n="skills.title">{t("skills.title")}</span>
      </h2>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category, catIdx) => (
        <div
          class={`reveal gradient-border rounded-3xl bg-white dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/50 p-6 sm:p-7 shadow-sm delay-${(catIdx % 3) * 100}`}
        >
          <!-- Category header -->
          <div class="flex items-center gap-3.5 mb-6">
            <div
              class={`w-10 h-10 rounded-xl flex items-center justify-center text-base font-bold bg-gradient-to-br ${category.iconBg} border border-slate-200/60 dark:border-slate-700/40 flex-shrink-0`}
            >
              <span class={category.iconText}>{category.iconLabel}</span>
            </div>
            <h3
              class="text-base font-bold text-slate-800 dark:text-slate-100 tracking-tight"
              data-i18n={category.titleKey}
            >
              {t(category.titleKey)}
            </h3>
          </div>

          <!-- Skill pills grid -->
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <div
                class="group flex items-center px-3 py-1.5 rounded-xl
                  bg-slate-50 dark:bg-slate-700/40
                  border border-slate-200/70 dark:border-slate-600/40
                  hover:border-brand-teal/50 dark:hover:border-brand-lime/40
                  hover:bg-brand-teal/5 dark:hover:bg-brand-teal/10
                  hover:shadow-sm
                  transition-all duration-200 hover:-translate-y-0.5 cursor-default"
              >
                <span class="text-[13px] font-medium text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white transition-colors duration-200">
                  {skill.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
