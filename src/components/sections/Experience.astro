---
import type { Language } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { t } = await useTranslations(lang);

interface ExperienceItem {
  key: string;
  roleKey: string;
  companyKey: string;
  periodKey: string;
  descKey: string;
  url?: string;
  isCurrent?: boolean;
  type: "work" | "education";
  techStack: string[];
}

const experiences: ExperienceItem[] = [
  {
    key: "trainingym",
    roleKey: "experience.trainingymRole",
    companyKey: "experience.trainingymCompany",
    periodKey: "experience.trainingymPeriod",
    descKey: "experience.trainingymDesc",
    isCurrent: true,
    type: "work",
    techStack: ["Node.js", "Railway", "Database Normalization", "Bulk Operations", "High Concurrency"],
  },
  {
    key: "activar",
    roleKey: "experience.activarRole",
    companyKey: "experience.activarCompany",
    periodKey: "experience.activarPeriod",
    descKey: "experience.activarDesc",
    url: "https://activ-ar.com.au",
    isCurrent: true,
    type: "work",
    techStack: ["React Native", "Expo", "AI Multi-provider", "Adapter & Strategy", "Apple Health", "Docker CI/CD"],
  },
  {
    key: "turnar",
    roleKey: "experience.turnarRole",
    companyKey: "experience.turnarCompany",
    periodKey: "experience.turnarPeriod",
    descKey: "experience.turnarDesc",
    url: "https://turnar.ar",
    isCurrent: true,
    type: "work",
    techStack: ["Next.js", "Node.js API", "PostgreSQL", "Mercado Pago API", "WhatsApp Automation", "SaaS Architecture"],
  },
  {
    key: "merovingian",
    roleKey: "experience.merovingianRole",
    companyKey: "experience.merovingianCompany",
    periodKey: "experience.merovingianPeriod",
    descKey: "experience.merovingianDesc",
    type: "work",
    techStack: ["Python", "Pandas", "SQL", "Power BI", "Data Modeling"],
  },
  {
    key: "utn",
    roleKey: "experience.utnDegree",
    companyKey: "experience.utnInstitution",
    periodKey: "experience.utnPeriod",
    descKey: "experience.utnDesc",
    isCurrent: true,
    type: "education",
    techStack: ["Sistemas Distribuidos", "Diseño de Sistemas", "Sistemas Operativos", "Redes & DB"],
  },
];
---

<section id="experience" class="py-32 sm:py-40 bg-white dark:bg-slate-900 relative overflow-hidden">
  <!-- Subtle background grid -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.025] dark:opacity-[0.04]"
    style="background-image: linear-gradient(rgba(83,181,152,1) 1px, transparent 1px), linear-gradient(90deg, rgba(83,181,152,1) 1px, transparent 1px); background-size: 56px 56px;"
  ></div>

  <!-- Ambient light orb -->
  <div
    class="absolute top-1/3 -left-48 w-[600px] h-[600px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(83,181,152,0.06) 0%, transparent 70%);"
    data-parallax="0.08"
  ></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <p class="eyebrow mb-3" data-i18n="experience.subtitle">{t("experience.subtitle")}</p>
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white section-title-center">
        <span data-i18n="experience.title">{t("experience.title")}</span>
      </h2>
    </div>

    <!-- Timeline list -->
    <div class="relative pl-6 sm:pl-10 space-y-10 before:absolute before:left-2 sm:before:left-3.5 before:top-3 before:bottom-3 before:w-0.5 before:bg-gradient-to-b before:from-brand-teal before:via-brand-lime/50 before:to-slate-300 dark:before:to-slate-700">
      {experiences.map((item, idx) => (
        <div class={`reveal relative group delay-${(idx % 4) * 100}`}>
          <!-- Timeline dot -->
          <div class="absolute -left-6 sm:-left-10 top-1.5 flex items-center justify-center">
            <span class="relative flex h-5 w-5 items-center justify-center">
              {item.isCurrent && (
                <span class="absolute inline-flex h-full w-full rounded-full bg-brand-lime opacity-40 animate-ping"></span>
              )}
              <span class={`relative inline-flex rounded-full h-3 w-3 ${item.type === 'education' ? 'bg-amber-400 border border-white dark:border-slate-900' : 'bg-brand-teal border border-white dark:border-slate-900'}`}></span>
            </span>
          </div>

          <!-- Content card -->
          <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-6 sm:p-8 backdrop-blur-sm shadow-sm hover:border-brand-teal/40 dark:hover:border-brand-lime/30 transition-all duration-300 hover:-translate-y-1">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2.5 mb-3">
              <div>
                <div class="flex flex-wrap items-center gap-2.5 mb-1">
                  <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight" data-i18n={item.roleKey}>
                    {t(item.roleKey)}
                  </h3>
                  {item.isCurrent && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-brand-lime/15 text-brand-teal dark:text-brand-lime border border-brand-lime/30">
                      {t("experience.present")}
                    </span>
                  )}
                </div>

                <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300 font-semibold text-sm sm:text-base">
                  <span data-i18n={item.companyKey}>{t(item.companyKey)}</span>
                  {item.url && (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-xs text-brand-teal dark:text-brand-lime hover:underline font-medium ml-1"
                    >
                      <span data-i18n="experience.viewSite">{t("experience.viewSite")}</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>

              <div class="text-xs sm:text-sm font-semibold text-slate-500 dark:text-slate-400 shrink-0 self-start py-1 px-3 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-700/40">
                <span data-i18n={item.periodKey}>{t(item.periodKey)}</span>
              </div>
            </div>

            <!-- Description -->
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-[15px] leading-relaxed mb-5" data-i18n={item.descKey}>
              {t(item.descKey)}
            </p>

            <!-- Tech stack chips -->
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-slate-200/60 dark:border-slate-700/50">
              {item.techStack.map((tech) => (
                <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-white dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-600/40">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
