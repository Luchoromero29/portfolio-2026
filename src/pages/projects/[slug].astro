---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import Footer from "../../components/ui/Footer.astro";
import { useTranslations } from "../../i18n/utils";
import { projects, getProjectBySlug } from "../../data/projects";
import type { Language } from "../../i18n/utils";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
  return Astro.redirect("/projects");
}

const currentIndex = projects.findIndex((p) => p.slug === slug);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : projects[projects.length - 1];
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : projects[0];

const lang: Language = "es";
const { t } = await useTranslations(lang);

const images = project.images.length > 0
  ? project.images
  : [project.thumbnail].filter(Boolean) as string[];
---

<Layout
  title={`${project.title} — Luciano Romero`}
  description={project.shortDescription}
  ogImage={project.thumbnail || (project.images[0] ?? "/assets/logo-lr.png")}
  ogImageAlt={`${project.title} - Proyecto por Luciano Romero`}
  ogType="article"
  lang={lang}
>
  <Navbar lang={lang} currentPath={`/projects/${slug}`} />

  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 pt-24 pb-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- ── Breadcrumb & Top Bar ────────────────────────────────────────── -->
      <div class="flex items-center justify-between py-6 mb-8 border-b border-slate-200/80 dark:border-slate-800">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors duration-200 group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          <span data-i18n="projects.backToProjects">{t("projects.backToProjects")}</span>
        </a>

        <div class="flex items-center gap-2">
          {project.featured && (
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-brand-lime/20 text-brand-teal dark:text-brand-lime border border-brand-lime/30">
              ★ {t("projects.featured")}
            </span>
          )}
          <span
            class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-200/80 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300/60 dark:border-slate-700/60"
            data-i18n={project.categoryKey}
          >
            {t(project.categoryKey)}
          </span>
        </div>
      </div>

      <!-- ── Hero Header ─────────────────────────────────────────────────── -->
      <div class="mb-12">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-teal dark:text-brand-lime" data-i18n={project.roleKey}>
            {t(project.roleKey)}
          </span>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{project.year}</span>
          <span class="text-slate-300 dark:text-slate-700">•</span>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400" data-i18n={project.statusKey}>{t(project.statusKey)}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6 leading-tight">
          {project.title}
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-4xl mb-8" data-i18n={`projectItems.${project.slug}.shortDescription`}>
          {t(`projectItems.${project.slug}.shortDescription`, project.shortDescription)}
        </p>

        <!-- Actions & Links Bar -->
        <div class="flex flex-wrap items-center gap-3.5">
          {project.liveDemo ? (
            <a
              href={project.liveDemo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-2xl text-sm font-bold text-slate-950 bg-gradient-to-r from-brand-lime to-brand-teal hover:scale-102 hover:shadow-xl hover:shadow-brand-teal/20 transition-all duration-300"
            >
              <span data-i18n="projects.liveDemo">{t("projects.liveDemo")}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl text-sm font-medium text-slate-400 dark:text-slate-500 border border-dashed border-slate-300 dark:border-slate-700">
              <span data-i18n="projects.noDemo">{t("projects.noDemo")}</span>
            </span>
          )}

          {project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl text-sm font-semibold bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all duration-200"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z" />
              </svg>
              <span>GitHub</span>
            </a>
          )}
        </div>
      </div>

      <!-- ── Media Gallery Showcase ────────────────────────────────────── -->
      <div class="mb-16">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400" data-i18n="projects.gallery">
            {t("projects.gallery")}
          </h2>
          <span class="text-xs text-slate-400 font-medium">
            <span id="carousel-counter">1</span> / {images.length}
          </span>
        </div>

        <!-- Main Display Carousel -->
        <div
          id="carousel"
          class="relative rounded-3xl overflow-hidden bg-slate-950 border border-slate-800 shadow-2xl mb-4 group"
          style="aspect-ratio: 16/9;"
        >
          <!-- Track -->
          <div id="carousel-track" class="flex h-full transition-transform duration-500 ease-out">
            {images.map((img, i) => (
              <div
                class="relative flex-shrink-0 w-full h-full cursor-zoom-in bg-slate-950 flex items-center justify-center p-2 sm:p-4 overflow-hidden"
                data-slide-index={i}
              >
                <!-- Ambient blurred background matching the image colors -->
                <img
                  src={img}
                  alt=""
                  aria-hidden="true"
                  class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-35 scale-125 pointer-events-none"
                  loading="lazy"
                />
                <img
                  src={img}
                  alt={`${project.title} ${i + 1}`}
                  class="relative z-10 max-w-full max-h-full object-contain select-none drop-shadow-2xl"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={i === 0 ? "high" : "auto"}
                />
              </div>
            ))}
          </div>

          <!-- Controls -->
          <button
            id="carousel-prev"
            class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-2xl bg-black/60 hover:bg-black/80 backdrop-blur-md text-white flex items-center justify-center transition-all duration-200 hover:scale-105 border border-white/10"
            aria-label="Previous image"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <button
            id="carousel-next"
            class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-2xl bg-black/60 hover:bg-black/80 backdrop-blur-md text-white flex items-center justify-center transition-all duration-200 hover:scale-105 border border-white/10"
            aria-label="Next image"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

          <!-- Zoom Hint -->
          <div class="absolute bottom-4 right-4 z-10 pointer-events-none px-3 py-1.5 rounded-xl bg-black/60 backdrop-blur-md text-white/80 text-xs font-semibold border border-white/10 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
            </svg>
            <span>Click para ampliar</span>
          </div>
        </div>

        <!-- Thumbnail Strip -->
        {images.length > 1 && (
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-thin">
            {images.map((img, i) => (
              <button
                class={`carousel-thumb flex-shrink-0 w-24 h-16 sm:w-28 sm:h-18 rounded-2xl overflow-hidden border-2 transition-all duration-200 bg-slate-950 p-1 ${
                  i === 0 ? "border-brand-teal scale-102" : "border-slate-200 dark:border-slate-800 opacity-60 hover:opacity-100"
                }`}
                data-thumb-index={i}
                aria-label={`Ver captura ${i + 1}`}
              >
                <img src={img} alt="" class="w-full h-full object-contain" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- ── Deep Dive Content Grid ─────────────────────────────────────── -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-20">

        <!-- Main Narrative Description -->
        <div class="lg:col-span-2 space-y-8">
          <div class="rounded-3xl p-7 sm:p-9 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight" data-i18n="projects.overview">
              {t("projects.overview")}
            </h3>
            <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed" data-i18n={`projectItems.${project.slug}.description`}>
              {t(`projectItems.${project.slug}.description`, project.description)}
            </p>
          </div>

          <!-- Architecture & Highlights -->
          <div class="rounded-3xl p-7 sm:p-9 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-5 tracking-tight" data-i18n="projects.keyFeatures">
              {t("projects.keyFeatures")}
            </h3>
            <ul class="space-y-3.5 text-slate-600 dark:text-slate-300 text-sm sm:text-base">
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-teal/15 text-brand-teal flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</span>
                <span>Arquitectura modular y escalable diseñada para alta concurrencia y mantenibilidad.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-teal/15 text-brand-teal flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</span>
                <span>Optimización integral de rendimiento, integración con APIs externas y experiencia de usuario fluida.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-brand-teal/15 text-brand-teal flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</span>
                <span>Despliegue y administración de infraestructura en entornos de producción.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Sidebar / Stack Metadata -->
        <div class="space-y-6">
          <div class="rounded-3xl p-7 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-4 uppercase tracking-wider text-xs" data-i18n="projects.technologies">
              {t("projects.technologies")}
            </h3>
            <div class="flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200/70 dark:border-slate-700/60">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <div class="rounded-3xl p-7 bg-gradient-to-br from-brand-teal/10 via-brand-mint/5 to-transparent border border-brand-teal/20">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-2">
              ¿Querés ver más detalles?
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
              Podemos coordinar una demo o profundizar en las decisiones técnicas y arquitectura detrás del proyecto.
            </p>
            <a
              href="/#contact"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-teal dark:text-brand-lime hover:underline"
            >
              <span>Contactar conmigo</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ── Next / Prev Navigation ────────────────────────────────────── -->
      <div class="border-t border-slate-200 dark:border-slate-800 pt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevProject && (
          <a
            href={`/projects/${prevProject.slug}`}
            class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-teal/40 dark:hover:border-brand-lime/30 bg-white dark:bg-slate-900 transition-all duration-200 flex items-center gap-4"
          >
            <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center group-hover:-translate-x-1 transition-transform">
              <svg class="w-5 h-5 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Anterior</span>
              <p class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-teal dark:group-hover:text-brand-lime transition-colors">
                {prevProject.title}
              </p>
            </div>
          </a>
        )}

        {nextProject && (
          <a
            href={`/projects/${nextProject.slug}`}
            class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-brand-teal/40 dark:hover:border-brand-lime/30 bg-white dark:bg-slate-900 transition-all duration-200 flex items-center justify-between gap-4 text-right sm:col-start-2"
          >
            <div>
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Siguiente</span>
              <p class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-teal dark:group-hover:text-brand-lime transition-colors">
                {nextProject.title}
              </p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <svg class="w-5 h-5 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        )}
      </div>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<!-- Lightbox Modal -->
<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
>
  <button id="lightbox-close" class="absolute top-5 right-5 w-10 h-10 flex items-center justify-center rounded-2xl bg-white/10 hover:bg-white/20 text-white transition-colors" aria-label="Cerrar">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <button id="lightbox-prev" class="absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-2xl bg-white/10 hover:bg-white/20 text-white transition-colors" aria-label="Anterior">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>

  <div class="relative mx-4 sm:mx-16 flex items-center justify-center max-w-[92vw] max-h-[85vh]">
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl bg-slate-950" />
  </div>

  <button id="lightbox-next" class="absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-2xl bg-white/10 hover:bg-white/20 text-white transition-colors" aria-label="Siguiente">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>
</div>

<script is:inline define:vars={{ totalImages: images.length, imageList: images }}>
  var currentIndex = 0;
  var track = document.getElementById("carousel-track");
  var counter = document.getElementById("carousel-counter");
  var thumbs = document.querySelectorAll(".carousel-thumb");

  function goToSlide(index) {
    if (index < 0) index = totalImages - 1;
    if (index >= totalImages) index = 0;
    currentIndex = index;
    if (track) track.style.transform = "translateX(-" + index * 100 + "%)";
    if (counter) counter.textContent = String(index + 1);

    thumbs.forEach(function (th, i) {
      var isActive = i === index;
      th.classList.toggle("border-brand-teal", isActive);
      th.classList.toggle("scale-102", isActive);
      th.classList.toggle("opacity-100", isActive);
      th.classList.toggle("border-slate-200", !isActive);
      th.classList.toggle("opacity-60", !isActive);
    });
  }

  var prevBtn = document.getElementById("carousel-prev");
  var nextBtn = document.getElementById("carousel-next");
  if (prevBtn) prevBtn.addEventListener("click", function () { goToSlide(currentIndex - 1); });
  if (nextBtn) nextBtn.addEventListener("click", function () { goToSlide(currentIndex + 1); });

  thumbs.forEach(function (t) {
    t.addEventListener("click", function () {
      goToSlide(parseInt(t.getAttribute("data-thumb-index")));
    });
  });

  // Lightbox
  var lightbox = document.getElementById("lightbox");
  var lightboxImg = document.getElementById("lightbox-img");

  function openLightbox(index) {
    if (index < 0) index = totalImages - 1;
    if (index >= totalImages) index = 0;
    currentIndex = index;
    if (lightboxImg) lightboxImg.src = imageList[index] || "";
    if (lightbox) {
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    }
  }

  document.querySelectorAll("[data-slide-index]").forEach(function (s) {
    s.addEventListener("click", function () {
      openLightbox(parseInt(s.getAttribute("data-slide-index")));
    });
  });

  var lbClose = document.getElementById("lightbox-close");
  var lbPrev = document.getElementById("lightbox-prev");
  var lbNext = document.getElementById("lightbox-next");

  if (lbClose) lbClose.addEventListener("click", closeLightbox);
  if (lbPrev) lbPrev.addEventListener("click", function () { openLightbox(currentIndex - 1); });
  if (lbNext) lbNext.addEventListener("click", function () { openLightbox(currentIndex + 1); });

  document.addEventListener("keydown", function (e) {
    if (lightbox && !lightbox.classList.contains("hidden")) {
      if (e.key === "ArrowLeft") openLightbox(currentIndex - 1);
      if (e.key === "ArrowRight") openLightbox(currentIndex + 1);
      if (e.key === "Escape") closeLightbox();
    }
  });

  if (lightbox) {
    lightbox.addEventListener("click", function (e) {
      if (e.target === lightbox) closeLightbox();
    });
  }
</script>
