---
import Button from "../ui/Button.astro";
import type { Language } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { t } = await useTranslations(lang);
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-slate-50 dark:bg-[#080d1a] transition-colors duration-300"
>
  <!-- ── Layered mesh background ─────────────────────────────────────── -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Primary orb — top right, teal -->
    <div
      data-parallax="0.12"
      class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full"
      style="background: radial-gradient(circle at 40% 40%, rgba(83,181,152,0.18) 0%, transparent 65%); animation: pulse-slow 6s ease-in-out infinite;"
    >
    </div>

    <!-- Secondary orb — bottom left, lime -->
    <div
      data-parallax="0.22"
      class="absolute -bottom-48 -left-48 w-[600px] h-[600px] rounded-full"
      style="background: radial-gradient(circle at 60% 60%, rgba(200,219,135,0.14) 0%, transparent 65%); animation: pulse-slow 8s ease-in-out infinite 2.5s;"
    >
    </div>

    <!-- Tertiary orb — center-left, seafoam -->
    <div
      data-parallax="0.08"
      class="absolute top-1/2 -left-20 w-[400px] h-[400px] rounded-full"
      style="background: radial-gradient(circle, rgba(106,189,160,0.08) 0%, transparent 70%); animation: pulse-slow 10s ease-in-out infinite 1s;"
    >
    </div>

    <!-- Fine grid / dots -->
    <div
      class="absolute inset-0 opacity-[0.035] dark:opacity-[0.04]"
      style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 36px 36px;"
    >
    </div>

    <!-- Subtle horizontal lines -->
    <div
      class="absolute inset-0 opacity-[0.02] dark:opacity-[0.03]"
      style="background-image: linear-gradient(currentColor 1px, transparent 1px); background-size: 100% 80px;"
    >
    </div>

    <!-- Floating geometric accents -->
    <div
      data-parallax="0.18"
      class="absolute top-[22%] left-[8%] w-14 h-14 rounded-2xl border border-brand-lime/30 dark:border-brand-lime/25"
      style="animation: float 7s ease-in-out infinite; backdrop-filter: blur(1px);"
    >
    </div>
    <div
      data-parallax="0.28"
      class="absolute top-[38%] right-[12%] w-7 h-7 rounded-lg border border-brand-teal/40 dark:border-brand-teal/35 rotate-45"
      style="animation: float 5s ease-in-out infinite 1.2s;"
    >
    </div>
    <div
      data-parallax="0.14"
      class="absolute bottom-[28%] right-[8%] w-10 h-10 rounded-xl border border-brand-seafoam/30 dark:border-brand-seafoam/25"
      style="animation: float 9s ease-in-out infinite 0.7s;"
    >
    </div>
  </div>

  <!-- ── Main content ────────────────────────────────────────────────── -->
  <div
    class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20"
  >
    <!-- Avatar + Availability Pill -->
    <!-- <div
      class="inline-flex items-center gap-3.5 px-4 py-2 rounded-full mb-8 bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-brand-teal/20 shadow-md backdrop-blur-md"
      style="animation: slide-down 0.7s cubic-bezier(0.16,1,0.3,1) both 0.15s;"
    >
   
      <div
        class="relative w-8 h-8 rounded-full overflow-hidden border-2 border-brand-teal shrink-0 shadow-sm"
      >
        <img
          src="/assets/frontal-perfil.jpeg"
          alt="Luciano Romero"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>


      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-brand-teal dark:bg-brand-lime opacity-60 animate-ping"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-teal dark:bg-brand-lime"
          ></span>
        </span>
        <span
          class="text-slate-800 dark:text-brand-lime text-xs font-bold tracking-wide"
          data-i18n="hero.available"
        >
          {t("hero.available")}
        </span>
      </div>
    </div> -->

    <!-- Greeting + Name -->
    <div
      class="mb-4"
      style="animation: blur-in 0.9s cubic-bezier(0.16,1,0.3,1) both 0.3s;"
    >
      <span
        class="block text-xl sm:text-2xl text-slate-500 dark:text-slate-400 font-light tracking-wide mb-3"
        data-i18n="hero.greeting"
      >
        {t("hero.greeting")}
      </span>
      <h1
        class="text-5xl sm:text-7xl md:text-8xl lg:text-[92px] font-extrabold tracking-tight text-slate-900 dark:text-white leading-none"
      >
        {t("hero.name")}
      </h1>
    </div>

    <!-- Role title with shimmer -->
    <div
      class="mb-6"
      style="animation: slide-up 0.8s cubic-bezier(0.16,1,0.3,1) both 0.5s;"
    >
      <p class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">
        <span class="text-gradient font-extrabold" data-i18n="hero.title"
          >{t("hero.title")}</span
        >
      </p>
    </div>

    <!-- Subtitle -->
    <p
      class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed"
      style="animation: fade-in 1s ease both 0.75s;"
      data-i18n="hero.subtitle"
    >
      {t("hero.subtitle")}
    </p>

    <!-- CTA buttons -->
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center mb-16"
      style="animation: slide-up 0.8s cubic-bezier(0.16,1,0.3,1) both 0.9s;"
    >
      <Button
        href="/projects"
        variant="primary"
        size="lg"
        class="magnetic group shadow-lg"
      >
        <span data-i18n="hero.ctaProjects">{t("hero.ctaProjects")}</span>
        <svg
          class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </Button>
      <Button href="#contact" variant="outline" size="lg" class="magnetic">
        <span data-i18n="hero.ctaContact">{t("hero.ctaContact")}</span>
      </Button>
    </div>
  </div>

  <!-- ── Scroll indicator ────────────────────────────────────────────── -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-400 dark:text-slate-600"
    style="animation: fade-in 1.2s ease both 1.8s;"
  >
    <span
      class="text-[10px] tracking-[0.2em] uppercase font-semibold"
      data-i18n="hero.scrollDown">{t("hero.scrollDown")}</span
    >
    <!-- Mouse icon -->
    <div
      class="w-5 h-8 rounded-full border border-slate-300 dark:border-slate-600 flex items-start justify-center p-1.5"
    >
      <div
        class="w-1 h-2 bg-brand-teal rounded-full"
        style="animation: slide-down 1.8s ease-in-out infinite;"
      >
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Magnetic button effect
  document.querySelectorAll(".magnetic").forEach(function (el) {
    el.addEventListener("mousemove", function (e) {
      var rect = el.getBoundingClientRect();
      var x = e.clientX - rect.left - rect.width / 2;
      var y = e.clientY - rect.top - rect.height / 2;
      el.style.transform =
        "translate(" + x * 0.18 + "px, " + y * 0.18 + "px) scale(1.02)";
    });
    el.addEventListener("mouseleave", function () {
      el.style.transform = "translate(0, 0) scale(1)";
    });
  });
</script>
